<Array as="points"><mxPoint x="1172" y="205"/><mxPoint x="1172" y="790"/><mxPoint x="530" y="790"/></Array></mxGeometry></mxCell><mxCell id="f_gd_ath" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;exitX=1;exitY=0.56;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="gold" target="athena"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f_cat_ath" value="esquemas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#8A8A8A;strokeWidth=1.5;dashed=1;dashPattern=1 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="catalog" target="athena"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f_ath_boss" value="consultas SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="athena" target="boss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="steps" value="&lt;b&gt;1&lt;/b&gt; Productor sintético y export diario del core · &lt;b&gt;2&lt;/b&gt; MSK recibe el flujo (productor idempotente, CP) · &lt;b&gt;3&lt;/b&gt; Streaming: Bronze en &amp;lt; 30 s y reglas por ventana · &lt;b&gt;4&lt;/b&gt; Delta Lake en S3 y alertas en DynamoDB&lt;br&gt;&lt;b&gt;5&lt;/b&gt; SNS avisa solo alertas nuevas (&amp;lt; 2 min) · &lt;b&gt;6&lt;/b&gt; Batch: Bronze → Silver → Gold cada 15 min · &lt;b&gt;7&lt;/b&gt; SQL en Athena · &lt;b&gt;8&lt;/b&gt; Airflow orquesta las transiciones · &lt;b&gt;9&lt;/b&gt; Gobierno, costo y observabilidad&lt;br&gt;&lt;b&gt;Despliegue:&lt;/b&gt; cuenta AWS con créditos (USD 100) · MSK 2 × kafka.t3.small · EC2 t3.xlarge (Spark) · EC2 t3.medium (Airflow + productor) · la infraestructura se crea y se destruye por sesión de trabajo" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="945" width="1270" height="52" as="geometry"/></mxCell><mxCell id="lgs0" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1310" y="952" width="1" height="1" as="geometry"/></mxCell><mxCell id="lgt0" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1350" y="952" width="1" height="1" as="geometry"/></mxCell><mxCell id="lge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#D6212A;strokeWidth=2;strokeWidth=1.5;" edge="1" parent="1" source="lgs0" target="lgt0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgl0" value="Tiempo real" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1356" y="944" width="140" height="16" as="geometry"/></mxCell><mxCell id="lgs1" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1310" y="968" width="1" height="1" as="geometry"/></mxCell><mxCell id="lgt1" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1350" y="968" width="1" height="1" as="geometry"/></mxCell><mxCell id="lge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#1A73E8;strokeWidth=2;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="lgs1" target="lgt1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgl1" value="Batch" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;align=left;ver