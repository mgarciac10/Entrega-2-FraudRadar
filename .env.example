# Copiar a .env y completar. El archivo .env no se sube al repositorio.
# En EC2 las credenciales vienen del rol de la instancia: no poner llaves aquí.

AWS_REGION=us-east-1

# Lakehouse
S3_BUCKET=
S3_LANDING_PREFIX=landing/
S3_LAKE_PREFIX=lake/
S3_CHECKPOINTS_PREFIX=checkpoints/

# Kafka (MSK en AWS; kafka:9092 con el perfil local de docker-compose)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=transactions

# Productor
PRODUCER_RATE_EPS=200
PRODUCER_FRAUD_RATIO=0.02

# Alertas
DYNAMODB_ALERTS_TABLE=fraud_alerts
SNS_ALERTS_TOPIC_ARN=

# Analítica
GLUE_DATABASE=fraudradar
ATHENA_RESULTS_S3=
