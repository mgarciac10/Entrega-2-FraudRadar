# Copiar a .env y completar. El archivo .env no se sube al repositorio.
# En EC2 las credenciales vienen del rol de la instancia: no poner llaves aquí.

# AWS (perfil de la CLI y región del proyecto)
AWS_PROFILE=fraudradar
AWS_REGION=us-east-2

# Correo del dueño de la cuenta: avisos de costo (AWS Budgets). No cambiarlo una vez creados
# los presupuestos: CloudFormation tendría que reemplazarlos y falla (nombre fijo).
BUDGET_EMAIL=

# Correo del analista de riesgo: alertas de fraude por SNS (se puede cambiar libremente)
ALERT_EMAIL=

# Lakehouse
S3_BUCKET=            # fraudradar-<id de cuenta>-us-east-2 (sale del output del stack)
S3_LANDING_PREFIX=landing/
S3_LAKE_PREFIX=lake/
S3_CHECKPOINTS_PREFIX=checkpoints/

# Spark. Vacíos = se derivan de S3_BUCKET (s3a://<bucket>/lake, /landing y /checkpoints).
# Para trabajar en local, sin AWS, fijar:
#   LAKE_URI=/data/lake  LANDING_URI=/data/catalogs  CHECKPOINT_URI=/data/checkpoints
# En Git Bash (Windows), activar MSYS_NO_PATHCONV=1 antes de docker compose (ver spark/README.md).
LAKE_URI=
LANDING_URI=
CHECKPOINT_URI=

# Kafka. Vacío = kafka:9092 (perfil local de docker-compose). En AWS: los brokers TLS de MSK
# (aws kafka get-bootstrap-brokers) y KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=transactions

# Streaming. Cambiar STREAM_SESSION cada vez que se crea un MSK nuevo (por ejemplo, la fecha y la hora):
# es la carpeta del checkpoint de ingest_bronze y la columna _session de Bronze
STREAM_SESSION=local

# Productor
PRODUCER_RATE_EPS=200
PRODUCER_FRAUD_RATIO=0.02

# Alertas
DYNAMODB_ALERTS_TABLE=fraud_alerts
SNS_ALERTS_TOPIC_ARN=

# Analítica
GLUE_DATABASE=fraudradar
ATHENA_RESULTS_S3=
